# ServiceNow Instance Configuration
SN_INSTANCE_URL=https://your-instance.service-now.com

# Authentication — choose one method:

# Option 1: Basic Auth
SN_AUTH_METHOD=basic
SN_USERNAME=admin
SN_PASSWORD=your-password

# Option 2: OAuth 2.0 (Client Credentials) — a service identity, no user involved
# SN_AUTH_METHOD=oauth
# SN_CLIENT_ID=your-client-id
# SN_CLIENT_SECRET=your-client-secret

# Option 3: OAuth 2.0 Authorization Code + PKCE — browser-delegated login.
# No password is stored; you authorise once in a browser and a refresh token is
# kept on disk. If the instance has SSO, the browser step goes via your IdP.
# Run `simple-servicenow-mcp login` once after setting these (from the directory holding this .env).
# SN_AUTH_METHOD=oauth_authorization_code
# SN_CLIENT_ID=your-client-id
# SN_CLIENT_SECRET=                       # omit entirely for a Public Client (PKCE only)
# SN_OAUTH_REDIRECT_URI=http://127.0.0.1:8765/callback
#   ^ must match the Application Registry entry byte for byte.
#     Use 127.0.0.1, NOT localhost — on macOS localhost can resolve to ::1,
#     which the loopback listener never sees.
# SN_OAUTH_SCOPE=                         # usually blank; set only if the instance demands one
# SN_TOKEN_STORE=                         # default: ~/.config/simple-servicenow-mcp/tokens.json

# Server Configuration
SN_API_TIMEOUT=30          # HTTP timeout in seconds
SN_DEFAULT_PAGE_SIZE=20    # Default page size for list queries (1-100)
SN_MAX_PAGE_SIZE=100       # Hard cap on page size (1-1000)

# Retry behaviour
SN_MAX_RETRIES=3           # Max retry attempts for 429/5xx/network errors (0-10)
SN_RETRY_BASE_DELAY=1.0    # Base seconds for exponential backoff
SN_RETRY_MAX_DELAY=60.0    # Cap on any single retry wait, in seconds

# Logging
SN_LOG_LEVEL=INFO          # DEBUG, INFO, WARNING, ERROR
SN_LOG_FORMAT=text         # text | json

# Multi-instance (optional)
# When set, the server runs in multi-instance mode and every tool accepts an
# optional `instance` parameter naming an entry from this file. See
# instances.example.json for the schema.
# SN_INSTANCES_FILE=./instances.json

# Safety (optional)
# Read-only is the DEFAULT: any tool that mutates ServiceNow (create/update/delete/
# comment/resolve/upload) refuses the call with a clear error. Set this to false
# (or pass --read-write on the CLI) to allow mutations.
# SN_READ_ONLY=true

# Tool packages (optional)
# Comma-separated subset of tool modules to expose. Unset loads a curated
# default — the "developer analytical" loop: core, itsm, scripts, catalog,
# audit (27 tools). Pass 'all' to opt into every module (43 tools, the
# previous default). Pin to a custom subset for narrow use cases. Unknown
# names fail-fast at startup.
# Valid: core, itsm, scripts, catalog, cmdb, knowledge, attachment, update_set, audit, all
# SN_TOOL_PACKAGES=all
# SN_TOOL_PACKAGES=core,itsm,cmdb
